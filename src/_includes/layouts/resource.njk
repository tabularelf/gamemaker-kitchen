---
layout: layouts/base.njk
bodyClass: body-post
---
<article class="post">
	<header class="post-header">
	<style>
		div.donation {
			text-align: right;
		}
	</style>
	{% ifAsync logo %} {% ifAsync logo_centered == true %} <center> {% endif %} <img src="{{ logo }}" {% ifAsync logo_alt %} alt="{{ logo_alt }}" {% endif %} width="{{ logo_width }}" height="{{ logo_height }}"> {% ifAsync logo_centered == true %} </center> {% endif %} {% endif %}
	<h1 class="post-title">{{ title }} {% ifAsync version %} v{{ version }} {% endif %}</h1>
	<h2>
	<nav class="post-author">
		{% ifAsync authors %}
			{% for author in authorsMetadata %}
				<a href="/authors/{{ author.safe }}">{{ author.name }}</a>{% ifAsync not loop.last %}, {% endif %}
			{% endfor %}
		{% endif %} 
	</nav>
	</h2>
	
	{% ifAsync link and link != "N/A" %}
	<div class="post-link">
		<a href="{{ link }}" target="_blank">Link to {{ title }}</a>
	</div>
	{% endif %}
	{% ifAsync plugins.length > 0 %}
	<div class="post-link">
		<a href="plugins" target="_parent">{{ plugins.length }} Plugins available here!</a>
	</div>
	{% endif %}

    <nav class="post-tags">
    {% for tag in tags %}
      <a href="/tags/{{ tag | safeURL }}/" class="tag">{{ tag }}</a>
    {% endfor %}
    </nav>

	<time class="post-date" datetime="{{ date | date('DATETIME') }}">
		{{ date | date('HUMAN_DATE') }} 
	</time>
	
	<!-- GM Version -->
	{% ifAsync gm_versions %}
		<p><b>GameMaker Version:</b>
		{% for version in gm_versions %}
     	 {{ version }}{% ifAsync not loop.last %},{% endif %}
    	{% endfor %}
	{% endif %}
	</p>

	{# Add reading time info #}
	{%- if includeReadingTime == true %}
      <p>{{ readingInfo.words }} words, {{ readingInfo.minutes }} min read</p>
    {% endif %}
	
	{% ifAsync donation_link %}
		<a href="{{ donation_link }}" target="_blank">{{ donation_text }}</a>
	{% endif %}

	{# Handles rendering all of the page lists #}
	{% ifAsync h2s.length > 0 %}
	<h3>Contents:</h3>

	{% set minLevel = 999 %}
	{% for h in h2s %}
	  {% ifAsync h.num < minLevel %}
	    {% set minLevel = h.num %}
	  {% endif %}
	{% endfor %}

	{% set prevLevel = 0 %}
	<ul>
	{% for heading in h2s %}
	    {% set level = heading.num - minLevel %}

	    {% ifAsync level > prevLevel %}
	        {% for i in range(prevLevel, level) %}
	        <ul>
	        {% endfor %}
	    {% elif level < prevLevel %}
	        {% for i in range(level, prevLevel) %}
	        </ul>
	        {% endfor %}
	    {% endif %}
	    <li><a href="#{{ heading.id }}">{{ heading.content }}</a></li>
	    {% set prevLevel = level %}
	{% endfor %}

    {% for i in range(0, prevLevel) %}
      </ul>
    {% endfor %}
      </ul>
    {% endif %}
	
	</header>

  <div class="post-body">
    {{ content | safe }}
  </div>
</article>

<hr>

<nav class="post-navigation">
  <ul>
    {%- set previousPost = search.previousPage(url, searchtype) %}
    {%- if previousPost %}
    <li>
      ← Previous: <a href="{{ previouspost.url }}" rel="prev">{{ previouspost.title }}</a>
    </li>
    {% endif %}

    {%- set nextPost = search.nextPage(url, searchtype) %}
    {%- if nextPost %}
    <li>
      <strong>Next: <a href="{{ nextpost.url }}" rel="next">{{ nextpost.title }}</a> →</strong>
    </li>
    {% endif %}
  </ul>
</nav>